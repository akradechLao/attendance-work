generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum GroupType {
  A
  B
}

enum AttendanceStatus {
  late
  on_time
}

enum ShiftCode {
  WC0001
  WC0002
  WC0003
  WC0004
  WC0005
  WC0006
  WC007
  WC008
  WC009
  WC010
  WC011
  WC012
  WC013
  WC014
}

enum DayType {
  working
  holiday
  dayOff
  specialOff
}

enum OnboardingStatus {
  in_progress
  completed
  on_hold
}

enum OnboardingDocStatus {
  pending
  submitted
  verified
  rejected
}

// ============================================
// TABLES
// ============================================

model Company {
  id              Int      @id @default(autoincrement())
  name            String
  telegramBotToken String? @map("telegram_bot_token")
  telegramChatId  String? @map("telegram_chat_id")
  createdAt       DateTime @default(now()) @map("created_at")

  employees       Employee[]
  adminUsers      AdminUser[]
  officeLocations OfficeLocation[]
  holidays        CompanyHoliday[]
  leaveTypes      LeaveType[]
  leaveRequests   LeaveRequest[]
  otRequests      OtRequest[]
  shiftSchedules  ShiftSchedule[]
  settings        CompanySetting[]

  @@map("companies")
}

model Employee {
  id            Int       @id @default(autoincrement())
  companyId     Int       @map("company_id")
  name          String
  groupType     GroupType @map("group_type")
  department    String?   @map("department")
  wfhQuota      Int       @default(1) @map("wfh_quota")
  preferredOffDay String? @map("preferred_off_day")
  pin           String?
  employeeCode  String?   @map("employee_code")
  supervisorName  String? @map("supervisor_name")
  supervisorLine  String? @map("supervisor_line")
  supervisorPhone String? @map("supervisor_phone")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company        Company           @relation(fields: [companyId], references: [id])
  attendanceLogs AttendanceLog[]
  shiftSchedules ShiftSchedule[]
  leaveRequests  LeaveRequest[]
  wfhRecords     WfhRecord[]
  otRequests     OtRequest[]
  onboarding     OnboardingRecord?

  @@index([companyId])
  @@index([employeeCode])
  @@map("employees")
}

model AttendanceLog {
  id            Int               @id @default(autoincrement())
  empId         Int               @map("emp_id")
  checkIn       String?           @map("check_in")
  checkInPhoto  String?           @db.Text @map("check_in_photo")
  checkOut      String?           @map("check_out")
  checkOutPhoto String?           @db.Text @map("check_out_photo")
  status        AttendanceStatus?
  latLong       String?           @map("lat_long")
  date          String
  createdAt     DateTime          @default(now()) @map("created_at")

  employee Employee @relation(fields: [empId], references: [id])

  @@unique([empId, date])
  @@index([date])
  @@map("attendance_logs")
}

model ShiftSchedule {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  empId     Int      @map("emp_id")
  workDate  String   @map("work_date")
  shiftCode ShiftCode @default(WC0002) @map("shift_code")
  dayType   DayType  @default(working) @map("day_type")
  createdAt DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [empId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@unique([empId, workDate])
  @@index([companyId])
  @@index([workDate])
  @@map("shift_schedules")
}

model LeaveRequest {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  empId       Int      @map("emp_id")
  leaveTypeId Int      @map("leave_type_id")
  startDate   String   @map("start_date")
  endDate     String   @map("end_date")
  reason      String
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")

  employee  Employee   @relation(fields: [empId], references: [id])
  leaveType LeaveType  @relation(fields: [leaveTypeId], references: [id])
  company   Company    @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([empId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model WfhRecord {
  id        Int      @id @default(autoincrement())
  empId     Int      @map("emp_id")
  date      String
  reason    String   @default("")
  status    String   @default("approved")
  createdAt DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [empId], references: [id])

  @@unique([empId, date])
  @@map("wfh_records")
}

model OtRequest {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  empId       Int      @map("emp_id")
  date        String
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  reason      String
  status      String   @default("pending")
  approvedBy  String?  @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [empId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([empId])
  @@index([status])
  @@map("ot_requests")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  companyId Int?     @map("company_id")
  username  String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id])

  @@map("admin_users")
}

model OfficeLocation {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(200) @map("radius_meters")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("office_locations")
}

model CompanyHoliday {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  date      String
  name      String
  year      Int
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId])
  @@index([year])
  @@map("company_holidays")
}

model LeaveType {
  id            Int      @id @default(autoincrement())
  companyId     Int      @map("company_id")
  name          String
  advanceDays   Int      @default(0) @map("advance_days")
  quotaMonthly  Int      @default(0) @map("quota_monthly")
  quotaDaily    Int      @default(0) @map("quota_daily")
  quotaContract Int      @default(0) @map("quota_contract")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  company     Company        @relation(fields: [companyId], references: [id])
  leaveRequests LeaveRequest[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("leave_types")
}

model CompanySetting {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@index([companyId])
  @@map("company_settings")
}

model OnboardingRecord {
  id          Int              @id @default(autoincrement())
  empId       Int              @unique @map("emp_id")
  status      OnboardingStatus @default(in_progress)
  startDate   String           @map("start_date")
  endDate     String?          @map("end_date")
  notes       String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  employee  Employee            @relation(fields: [empId], references: [id])
  steps     OnboardingStep[]
  documents OnboardingDocument[]
  equipment OnboardingEquipment[]
  training  OnboardingTraining[]

  @@map("onboarding_records")
}

model OnboardingStep {
  id           Int              @id @default(autoincrement())
  onboardingId Int              @map("onboarding_id")
  stepOrder    Int              @map("step_order")
  stepKey      String           @map("step_key")
  stepLabel    String           @map("step_label")
  isCompleted  Boolean          @default(false) @map("is_completed")
  completedAt  DateTime?        @map("completed_at")
  completedBy  String?          @map("completed_by")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")

  onboarding OnboardingRecord @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@unique([onboardingId, stepKey])
  @@map("onboarding_steps")
}

model OnboardingDocument {
  id           Int              @id @default(autoincrement())
  onboardingId Int              @map("onboarding_id")
  docType      String           @map("doc_type")
  docLabel     String           @map("doc_label")
  status       OnboardingDocStatus @default(pending)
  fileUrl      String?          @db.Text @map("file_url")
  fileName     String?          @map("file_name")
  notes        String?
  verifiedAt   DateTime?        @map("verified_at")
  verifiedBy   String?          @map("verified_by")
  createdAt    DateTime         @default(now()) @map("created_at")

  onboarding OnboardingRecord @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@map("onboarding_documents")
}

model OnboardingEquipment {
  id           Int      @id @default(autoincrement())
  onboardingId Int      @map("onboarding_id")
  equipType    String   @map("equip_type")
  equipName    String   @map("equip_name")
  serialNumber String?  @map("serial_number")
  notes        String?
  assignedAt   DateTime? @map("assigned_at")
  returnedAt   DateTime? @map("returned_at")
  createdAt    DateTime @default(now()) @map("created_at")

  onboarding OnboardingRecord @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@map("onboarding_equipment")
}

model OnboardingTraining {
  id           Int      @id @default(autoincrement())
  onboardingId Int      @map("onboarding_id")
  trainingName String   @map("training_name")
  trainer      String?
  scheduledDate String? @map("scheduled_date")
  completedDate String? @map("completed_date")
  status       String   @default("scheduled")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  onboarding OnboardingRecord @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@map("onboarding_training")
}
